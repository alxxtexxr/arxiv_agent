ARXIV_AGENT_PORT=2024
ARXIV_RECOMMENDATION_CATEGORY="cs.AI"

# Key configuration
LANGSMITH_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY= # Free alternative

# LangChain configuration
LANGCHAIN_TRACING="false"
LANGCHAIN_TRACING_V2="false"

# Chat model configuration
# CHAT_MODEL must use the format 'model_provider:model_name'
CHAT_MODEL="openai:gpt-5.6-luna"
CHAT_MODEL_REASONING_EFFORT="medium"

# GitHub bookmarks configuration
GITHUB_TOKEN=
GITHUB_BOOKMARKS_URL=

# Embedding configuration
VECTOR_DATABASE_URI="postgres://postgres@localhost:5432/arxiv_agent"
EMBEDDING_INTEGRATION="fastembed" # 'openai' | 'fastembed' | 'tei' | 'hf' or 'huggingface'
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
TEI_EMBEDDINNG_URL=
ENABLE_EMBEDDING_CACHE="true" # 'true' | 'false' — in-memory embedding model cache

# Reranking configuration
RERANKER_INTEGRATION="flashrank" # 'flashrank' | 'tei' | 'hf' or 'huggingface'
RERANKER_MODEL="ms-marco-MiniLM-L-12-v2"
TEI_RERANKER_URL=
ENABLE_RERANKER_CACHE="true" # 'true' | 'false' — in-memory reranker model cache

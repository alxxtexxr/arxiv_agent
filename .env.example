LANGSMITH_API_KEY=
ARXIV_RECOMMENDATION_CATEGORY="cs.AI"

# Model configuration
OPENAI_API_KEY=
MODEL_PROVIDER="openai"
MODEL_NAME="gpt-5.6-luna"
MODEL_REASONING_EFFORT="none"

# GitHub bookmarks configuration
GITHUB_TOKEN=
GITHUB_BOOKMARKS_URL=

# Embedding configuration
VECTOR_DATABASE_URI="postgresql://postgres@localhost:5432/arxiv_agent"
EMBEDDING_STRATEGY="tei" # 'openai' | 'tei' | 'hf' or 'huggingface'
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
TEI_EMBEDDING_URL="http://localhost:8080"
RERANKER_STRATEGY="tei" # 'tei' | 'hf' or 'huggingface'
RERANKER_MODEL="BAAI/bge-reranker-base"
TEI_RERANKER_URL="http://localhost:8081"

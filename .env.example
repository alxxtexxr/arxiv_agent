ARXIV_RECOMMENDATION_CATEGORY="cs.AI"

# Key configuration
LANGSMITH_API_KEY=
OPENAI_API_KEY=

# Chat model configuration
CHAT_MODEL="openai/gpt-5.6-luna"
CHAT_MODEL_REASONING_EFFORT="none"

# GitHub bookmarks configuration
GITHUB_TOKEN=
GITHUB_BOOKMARKS_URL=

# Embedding configuration
VECTOR_DATABASE_URI="postgresql://postgres@localhost:5432/arxiv_agent"
EMBEDDING_INTEGRATION="tei" # 'openai' | 'tei' | 'hf' or 'huggingface'
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
TEI_EMBEDDINNG_URL="http://localhost:8080"
ENABLE_EMBEDDING_CACHE="true" # 'true' | 'false' — in-memory embedding model cache

# Reranking configuration
RERANKER_INTEGRATION="tei" # 'tei' | 'hf' or 'huggingface'
RERANKER_MODEL="BAAI/bge-reranker-base"
TEI_RERANKER_URL="http://localhost:8081"
ENABLE_RERANKER_CACHE="true" # 'true' | 'false' — in-memory reranker model cache

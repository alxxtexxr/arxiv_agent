LANGSMITH_DEPLOYMENT_NAME="arxiv-agent"
LANGSMITH_API_KEY=

OPENAI_API_KEY=
MODEL_PROVIDER="openai"
MODEL_NAME="gpt-5.6-luna"
MODEL_REASONING_EFFORT="max"

ARXIV_RECOMMENDATION_CATEGORY="cs.AI"

# Variables specific to the production environment
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="postgres" # Database created when the postgres service is initialized
DATABASE_URI="postgres://postgres:postgres@postgres:5432/postgres?sslmode=disable"

ARXIV_AGENT_POSTGRES_URI="postgresql://postgres:postgres@postgres:5432/arxiv_agent"
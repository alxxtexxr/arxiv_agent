LANGSMITH_API_KEY=
ARXIV_RECOMMENDATION_CATEGORY="cs.AI"

# Model configuration
OPENAI_API_KEY=
MODEL_PROVIDER="openai"
MODEL_NAME="gpt-5.6-luna"
MODEL_REASONING_EFFORT="none"

# GitHub bookmarks configuration
GITHUB_TOKEN=
GITHUB_BOOKMARKS_URL=

# ================================
# Production configuration
# ================================
# Checkpointer database configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="postgres" # Database created when the postgres service is initialized
DATABASE_URI="postgres://postgres:postgres@postgres:5432/postgres?sslmode=disable"

# Embedding configuration
VECTOR_DATABASE_URI="postgresql://postgres:postgres@postgres:5432/arxiv_agent"
EMBEDDING_STRATEGY="tei" # 'openai' | 'tei' | 'hf' or 'huggingface'
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
RERANKER_MODEL="BAAI/bge-reranker-base"